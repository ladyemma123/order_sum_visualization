MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=yingdao_gy
MYSQL_TABLE=gy_workorder_summary

# 服务端口配置，默认3000
PORT=3000

# SSL 连接配置
# 腾讯云 CynosDB 通常不需要 SSL，设置为 false
# 阿里云 RDS 部分实例需要 SSL，可设置为 true
MYSQL_USE_SSL=false

# 连接超时时间（毫秒），云数据库建议设置较长时间
# MYSQL_CONNECT_TIMEOUT=15000
