MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=yingdao_gy
MYSQL_TABLE=gy_workorder_summary

# 云数据库配置说明：
# 腾讯云 CynosDB/MySQL: sh-cynosdbmysql-grp-xxx.sql.tencentcdb.com
# 阿里云 RDS: xxx.mysql.rds.aliyuncs.com
# 华为云 RDS: xxx.mysql.polardb.polardb
# Azure MySQL: xxx.mysql.database.azure.com
# 
# 云数据库通常需要 SSL 连接，系统会自动检测并启用 SSL
# 如果 SSL 连接失败，可以尝试设置 MYSQL_SSL_REJECT_UNAUTHORIZED=false
# 连接超时时间可根据网络情况调整
